# VeloRoute public site — copy to .env.local

# Creliora API host (no trailing slash; /api/v1 is appended automatically)
# Parcel photos/docs upload via POST /parcels/upload/{image|file} and land in
# the same Supabase Storage bucket as Creliora (creliora → parcels/…).
NEXT_PUBLIC_API_URL=http://localhost:5001

# Canonical site URL for SEO, sitemap, and Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Optional — enables interactive Google Maps on tracking pages
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
